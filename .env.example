# ========== 对话模型（二选一）==========
# deepseek：主/子 Agent、复杂度评估、上下文摘要（OpenAI 兼容 API）
# dashscope：通义千问全链路
LLM_PROVIDER=deepseek

# DeepSeek（LLM_PROVIDER=deepseek 时必填）
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
COMPRESSION_MODEL_NAME=deepseek-chat
DECOMPOSE_MODEL_NAME=deepseek-chat

# DashScope（EMBEDDING_PROVIDER=dashscope 或 LLM_PROVIDER=dashscope 时必填）
DASHSCOPE_API_KEY=your_dashscope_api_key
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1

# ========== RAG 向量嵌入 ==========
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# 使用 DeepSeek Embedding（OpenAI 兼容）示例：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=deepseek-embedding-v2
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BASE_URL=https://api.deepseek.com
# （Key 可留空，自动使用 DEEPSEEK_API_KEY）

# 若改回通义对话，示例：
# LLM_PROVIDER=dashscope
# MODEL_NAME=qwen-plus
# COMPRESSION_MODEL_NAME=qwen-turbo
# DECOMPOSE_MODEL_NAME=qwen-turbo

# ========== 存储与记忆 ==========
USER_ID=default_user
AGENT_NAME=InsuranceAgent
VECTOR_STORE_PATH=./data/vector_store
LONG_TERM_MEMORY_PATH=./data/memory_store
# 长期记忆：仅画像/偏好摘要，不存问答全文；启发式命中时自动提取
LONG_TERM_AUTO_PROFILE=true
# PROFILE_MODEL_NAME=deepseek-chat

# ========== Agent 行为（主 Agent 统一入口；多子问题由 delegate_subagents 工具触发）==========
MAX_MAIN_AGENT_RETRIEVALS=5
MAX_MAIN_AGENT_RETRIEVALS_LOW=3
MAX_MAIN_AGENT_RETRIEVALS_HIGH=6
SUBAGENT_ENABLED=true
SUBAGENT_MIN_QUESTIONS=2
MAX_SUBAGENTS=5
MAX_SUBAGENT_CONCURRENCY=3
MAX_SUBAGENT_RETRIEVALS=4
MAX_SUBAGENT_RETRIEVALS_HIGH=5

RAG_TOOL_LIMIT=3
RAG_MAX_CHUNK_DISPLAY_CHARS=2000
RAG_MAX_TOOL_RESPONSE_CHARS=8000
# 两层上下文：80% 软视图 / max(93%, window-13k) 硬重写
# MODEL_CONTEXT_WINDOW=0
CONTEXT_SOFT_RATIO=0.8
CONTEXT_HARD_RATIO=0.93
CONTEXT_HARD_RESERVE_TOKENS=13000
COMPRESSION_MODEL_NAME=deepseek-chat
# 未设置时代码默认 4；推荐 5 以保留更多最近原文
AGENT_COMPRESSION_KEEP_RECENT=5
SUBAGENT_TOOL_MAX_CHARS=3500

# 合规文案（仅前端展示，不写入 Agent 回答）
# DISCLAIMER_TEXT=回答仅供参考，不构成任何保险承诺或法律建议。...
# SOURCE_NOTICE_TEXT=以上回答基于知识库检索结果整理，具体条款内容请以正式保险合同原文为准。

API_HOST=127.0.0.1
API_PORT=8001
